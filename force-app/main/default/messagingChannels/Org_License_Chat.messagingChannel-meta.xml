<?xml version="1.0" encoding="UTF-8"?>
<MessagingChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Org License Chat</masterLabel>
    <description>Guest-accessible Messaging for In-App and Web channel that fronts the Org License service agent on the External React site.</description>
    <messagingChannelType>EmbeddedMessaging</messagingChannelType>
    <embeddedConfig>
        <authMode>UnAuth</authMode>
        <isAttachmentUploadEnabled>false</isAttachmentUploadEnabled>
        <isEstimatedWaitTimeEnabled>false</isEstimatedWaitTimeEnabled>
        <isSaveTranscriptEnabled>false</isSaveTranscriptEnabled>
    </embeddedConfig>
    <sessionHandlerAsa>Org_License_Service_Agent</sessionHandlerAsa>
    <sessionHandlerQueue>Org_License_Chat_Fallback</sessionHandlerQueue>
    <sessionHandlerType>AgentforceServiceAgent</sessionHandlerType>
</MessagingChannel>
