subagent case_management:
    label: "Case Management"
    description: "Looks up a Salesforce Case by case number and returns its current status"
    reasoning:
        instructions: ->
            | You help users check Salesforce Case status.
              When the user asks for the status of a case:
              1. Extract the case number exactly as provided.
              2. Preserve all leading zeros.
              3. Immediately call Get_Case_Status with the extracted value in caseNumberText.
              4. Do not send placeholder text or claim that you are checking.
              5. Only answer after the action returns.
              6. If CaseStatus is returned, clearly state the case number and status.
              7. If the action fails or returns no status, explain that the status could not be retrieved.
              Never use a GitHub action for Salesforce Case status lookup.
        actions:
            Get_Case_Status: @actions.Get_Case_Status
                with caseNumberText = ...

    actions:
        Get_Case_Status:
            label: "Get Salesforce Case Status"
            description: "Sends a Salesforce Case Number and returns its current status."
            target: "flow://CaseStatus_Flow"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Checking the Salesforce case status"
            inputs:
                caseNumberText: string
                    label: "Case Number"
                    description: "The Salesforce Case Number, preserving leading zeros."
                    is_required: True
            outputs:
                CaseStatus: string
                    label: "Case Status"
                    description: "The current status of the Salesforce Case."
                    is_displayable: True
                    filter_from_agent: False

subagent sales_cloud_knowledge:
    label: "Sales Cloud Knowledge"
    description: "Answers sales, product, FAQ, and informational questions using the configured data library"
    reasoning:
        instructions: ->
            | For every request routed here, first call Answer_Questions_With_Knowledge.
              Pass the user's complete request as query without changing its meaning.
              Base the answer entirely on knowledgeSummary returned by the action.
              Never answer from general knowledge or before the search returns.
              Preserve citations and source links included in knowledgeSummary.
              If citationSources contains additional source URLs, list them under a "Sources:" heading.
              If no relevant content is returned, say that the configured data library has no relevant information
              and ask the user to refine the question.
        actions:
            Answer_Questions_With_Knowledge: @actions.Answer_Questions_With_Knowledge
                with query = ...
                with citationsUrl = ...
                with ragFeatureConfigId = ...
                with citationsEnabled = ...

    actions:
        Answer_Questions_With_Knowledge:
            label: "Answer Questions with Knowledge"
            description: "Answers questions using only content retrieved from the configured Sales Cloud data library."
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Searching the Sales Cloud data library"
            source: "EmployeeCopilot__AnswerQuestionsWithKnowledge"
            target: "standardInvocableAction://streamKnowledgeSearch"
            inputs:
                query: string
                    description: "Required. The user's complete question to search for in the data library."
                    label: "Query"
                    is_required: True
                    is_user_input: True
                    complex_data_type_name: "lightning__textType"
                citationsUrl: string = @knowledge.citations_url
                    description: "The URL to use for citations."
                    label: "Citations URL"
                    is_required: False
                    is_user_input: True
                    complex_data_type_name: "lightning__textType"
                ragFeatureConfigId: string = @knowledge.rag_feature_config_id
                    description: "The RAG feature configuration for the Sales Cloud data library."
                    label: "RAG Feature Configuration ID"
                    is_required: False
                    is_user_input: True
                    complex_data_type_name: "lightning__textType"
                citationsEnabled: boolean = @knowledge.citations_enabled
                    description: "Whether citations are enabled."
                    label: "Citations Enabled"
                    is_required: False
                    is_user_input: True
                    complex_data_type_name: "lightning__booleanType"
            outputs:
                knowledgeSummary: object
                    description: "A grounded rich-text answer from the configured data library, including citations."
                    label: "Knowledge Summary"
                    complex_data_type_name: "lightning__richTextType"
                    is_displayable: True
                    filter_from_agent: False
                citationSources: object
                    description: "Source links for the retrieved content."
                    label: "Citation Sources"
                    complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationInput"
                    is_displayable: False
                    filter_from_agent: False

subagent off_topic:
    label: "Off Topic"
    description: "Handles requests that are not GitHub repository operations"
    reasoning:
        instructions: ->
            | Politely say you support GitHub cloud tasks, Salesforce Case status lookup, and questions grounded in
              the configured Sales Cloud data library. GitHub tasks include creating branches, copying branch assets
              or a single folder, reading and updating file contents, analyzing Salesforce metadata dependencies,
              listing branches, and listing files.
              Invite the user to try an example from the welcome message.
