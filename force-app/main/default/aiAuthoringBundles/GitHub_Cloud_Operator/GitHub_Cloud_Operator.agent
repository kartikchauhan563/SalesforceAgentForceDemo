subagent dependency_analysis:
    label: "Salesforce Dependency Analysis"
    description: "Finds Apex, flow, trigger, object, LWC, Aura, permission set, and other metadata dependencies for a GitHub file or feature"
    reasoning:
        instructions: ->
            | You analyze Salesforce metadata dependencies through the GitHub cloud action only.
              You must call GitHub_Analyze_Dependencies before answering. Never invent dependencies and never answer
              from memory.
              Accept any of these forms:
                - Flow developer name, such as Update_Application_AI_Output_Flow
                - Apex class or trigger name
                - Full repository file path
                - Feature or metadata name
              Default repo is kartikchauhan563/SalesforceAgentForceDemo and default branch is master.
              Pass the user's exact file or feature text in fileOrFeature. Pass branch only when the user names one.
              The action returns two dependency directions:
                - Depends on: components referenced by the matched target file.
                - Used by: repository files that reference the target name.
              Forward dependency content comes from the requested branch. Used-by results come from GitHub code
              search, which searches the repository's indexed default branch. Explain this distinction when the user
              requests a non-default branch.
              Group the response by direction and metadata type. Include full paths so the user can identify each
              Apex class, flow, trigger, object, LWC, Aura component, permission set, or other metadata item.
              Clearly state when no exact target file matched and the result is based only on reverse-reference
              search. Clearly repeat any reverse-search warning from the action.
              Do not claim that heuristic results are a complete Salesforce deployment package. Say that dynamic
              references, runtime-generated names, and references outside GitHub may require manual validation.
              If success is false, quote the action message verbatim.
        actions:
            GitHub_Analyze_Dependencies: @actions.GitHub_Analyze_Dependencies
                with owner = ...
                with repo = ...
                with ownerRepo = ...
                with branch = ...
                with fileOrFeature = ...

    actions:
        GitHub_Analyze_Dependencies:
            label: "GitHub Analyze Salesforce Dependencies"
            description: "Finds forward and reverse Salesforce metadata dependencies for a file, flow, class, trigger, or feature."
            target: "apex://GitHubAction_GetDependencies"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Analyzing Salesforce metadata dependencies"
            inputs:
                owner: string
                    label: "Owner"
                    description: "GitHub owner or org. Leave empty to use kartikchauhan563."
                    is_required: False
                repo: string
                    label: "Repository"
                    description: "Repository name or owner/repo."
                    is_required: False
                ownerRepo: string
                    label: "Owner And Repo"
                    description: "Full identifier such as kartikchauhan563/SalesforceAgentForceDemo."
                    is_required: False
                branch: string
                    label: "Branch"
                    description: "Branch whose matched file content should be analyzed. Defaults to master."
                    is_required: False
                fileOrFeature: string
                    label: "File Or Feature"
                    description: "File path, flow name, Apex class, trigger, metadata developer name, or feature name."
                    is_required: True
            outputs:
                success: boolean
                    label: "Success"
                    is_displayable: False
                    filter_from_agent: False
                message: string
                    label: "Dependency Summary"
                    is_displayable: True
                    filter_from_agent: False
                detailsJson: string
                    label: "Dependency Details JSON"
                    is_displayable: True
                    filter_from_agent: False

subagent file_editing:
    label: "File Editing"
    description: "Reads a file from a GitHub branch and commits new or updated file content using cloud callouts"
    reasoning:
        instructions: ->
            | You read and write GitHub file contents through Salesforce cloud actions only. Never suggest local edits.
              You must call an action before answering. Never promise to make a change later and never send
              placeholder text. You have no background processing.
              Default repo is kartikchauhan563/SalesforceAgentForceDemo and the default branch is master.
              If ActiveNewBranch is set, use that branch for reads and writes unless the user names a different branch.
              To change an existing file you must follow this order:
                1. Call GitHub_Get_File for that path and branch to retrieve the current content.
                2. Apply the user's requested change to the content you received.
                3. Call GitHub_Update_File with fileContent set to the COMPLETE new file text.
              GitHub_Update_File replaces the whole file, so never send only the changed lines or a diff. Always send
              the full file text including the parts you did not change.
              To create a brand new file, call GitHub_Update_File directly with the full content. Do not call
              GitHub_Get_File first for a file the user says is new.
              Writing to the default branch "master" affects the mainline, so if the user did not name a branch, ask
              which branch to commit to before calling GitHub_Update_File. Never guess a branch for a write.
              If the user names a branch that does not exist, tell them and offer to create it with the branch actions.
              If the user asks only to see or read a file, call GitHub_Get_File and show the content. Do not write.
              When you do not know the exact file path, call GitHub_Get_File only after you already identified a
              path. If ActiveNewBranch is set and the user described a requirement without a path, do not ask them
              to name files. Infer the files from the requirement and the copied project layout. Never invent a path
              that you have not seen from an action.
              After a write, report the file path, the branch, and the GitHub URL from the action message.
              If success is false, quote the action message verbatim.
        actions:
            GitHub_Get_File: @actions.GitHub_Get_File
                with owner = ...
                with repo = ...
                with ownerRepo = ...
                with branch = ...
                with filePath = ...
            GitHub_Update_File: @actions.GitHub_Update_File
                with owner = ...
                with repo = ...
                with ownerRepo = ...
                with branch = ...
                with filePath = ...
                with fileContent = ...
                with commitMessage = ...

    actions:
        GitHub_Get_File:
            label: "GitHub Get File"
            description: "Reads the text content of one file on a GitHub branch."
            target: "apex://GitHubAction_GetFile"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Reading the file from GitHub"
            inputs:
                owner: string
                    label: "Owner"
                    description: "GitHub owner or org. Leave empty to use kartikchauhan563."
                    is_required: False
                repo: string
                    label: "Repository"
                    description: "Repository name or owner/repo."
                    is_required: False
                ownerRepo: string
                    label: "Owner And Repo"
                    description: "Full identifier such as kartikchauhan563/SalesforceAgentForceDemo."
                    is_required: False
                branch: string
                    label: "Branch"
                    description: "Branch to read from. Defaults to master."
                    is_required: False
                filePath: string
                    label: "File Path"
                    description: "Full file path such as force-app/main/default/classes/EMICalculator.cls."
                    is_required: True
            outputs:
                success: boolean
                    label: "Success"
                    is_displayable: False
                    filter_from_agent: False
                message: string
                    label: "Message"
                    is_displayable: True
                    filter_from_agent: False
                content: string
                    label: "File Content"
                    is_displayable: True
                    filter_from_agent: False
                detailsJson: string
                    label: "Details JSON"
                    is_displayable: False
                    filter_from_agent: False

        GitHub_Update_File:
            label: "GitHub Update File"
            description: "Creates or updates a file on a GitHub branch with the complete supplied content."
            target: "apex://GitHubAction_UpsertFile"
            require_user_confirmation: True
            include_in_progress_indicator: True
            progress_indicator_message: "Committing the file change to GitHub"
            inputs:
                owner: string
                    label: "Owner"
                    description: "GitHub owner or org. Leave empty to use kartikchauhan563."
                    is_required: False
                repo: string
                    label: "Repository"
                    description: "Repository name or owner/repo."
                    is_required: False
                ownerRepo: string
                    label: "Owner And Repo"
                    description: "Full identifier such as kartikchauhan563/SalesforceAgentForceDemo."
                    is_required: False
                branch: string
                    label: "Branch"
                    description: "Branch to commit to. Ask the user when they did not name one."
                    is_required: False
                filePath: string
                    label: "File Path"
                    description: "Full file path such as force-app/main/default/classes/EMICalculator.cls."
                    is_required: True
                fileContent: string
                    label: "File Content"
                    description: "The complete text the file should contain after the change, not a diff."
                    is_required: True
                commitMessage: string
                    label: "Commit Message"
                    description: "Optional commit message."
                    is_required: False
            outputs:
                success: boolean
                    label: "Success"
                    is_displayable: False
                    filter_from_agent: False
                message: string
                    label: "Message"
                    is_displayable: True
                    filter_from_agent: False
                detailsJson: string
                    label: "Details JSON"
                    is_displayable: False
                    filter_from_agent: False

