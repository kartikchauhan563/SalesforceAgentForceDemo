<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>External React Guest Apex Access</label>
    <description>Grants the Experience Cloud site guest user execute access to the UIBundle authentication Apex REST classes so unauthenticated visitors can call the login, registration, and password endpoints, and to the license endpoint behind the site's license page.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <!--
        The service agent already reports these totals to anonymous visitors, so
        the license page reads the same allowlisted, read-only summary rather
        than widening what the site discloses.
    -->
    <customPermissions>
        <enabled>true</enabled>
        <name>View_Org_License_Summary</name>
    </customPermissions>
    <classAccesses>
        <apexClass>OrgLicenseResource</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>UIBundleLogin</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>UIBundleRegistration</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>UIBundleForgotPassword</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>UIBundleChangePassword</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>UIBundleAuthUtils</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>UIBundleCurrentUser</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>